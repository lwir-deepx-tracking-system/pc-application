{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug pc-application",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/pc-application.exe",
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "PATH",
                    "value": "${env:QT_ROOT}/bin;${env:PATH}"
                }
            ],
            "console": "integratedTerminal"
        }
    ]
}
